# --- PlatformIO / ESP-IDF build artifacts ---
.pio/
build/
managed_components/
dependencies.lock
# ESP-IDF generated config (regenerated from sdkconfig.defaults)
sdkconfig.esp32s3*

# --- VS Code (machine-specific) ---
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# --- Python (host tests / tooling) ---
__pycache__/
*.pyc
.pytest_cache/

# --- OTA firmware images (build artifacts) ---
FIRMWARE_UPDATES/*.bin

# --- Local secrets (never commit) ---
.env
*credentials.local*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*~
*.swp
.idea/

# Local WLAN provisioning (real credentials) — never commit
src/network/network.json
src/network/network_json_gen.c
# TLS material (copied from the testbed PKI ../DO_NOT_COMMIT/CA) — never commit
src/network/certs/
src/network/certs_gen.c

# Build info (regenerated on every build, tools/gen_build_info.py)
src/main/build_info_gen.h
src/main/build_info_static_gen.h

# Series production (serienfertigung.md §26): build artefacts + factory data.
# Secrets live outside the repo (../DO_NOT_COMMIT/production_secrets);
# these rules are defense-in-depth.
dist/
production/secrets/
*.factory.csv
*.factory.bin

# Build artefacts (versioned OTA images from ./build.sh)
binary/

# Ad-hoc packaging (do not version)
/fountainer.tar.gz
