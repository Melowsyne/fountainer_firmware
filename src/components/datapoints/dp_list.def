/* ============================================================================
 * dp_list.def  —  THE single source of truth for all data points.
 * ----------------------------------------------------------------------------
 * This file is an "X-macro" list. It is #included several times by
 * datapoints.h / datapoints.c, each time with a different definition of the
 * DP(...) macro, to generate (without repeating anything):
 *
 *   - the dp_id_t enum            (DP_ID_<name>, plus DP_COUNT)
 *   - the storage image struct    (one field per data point -> auto offsets)
 *   - the descriptor table        (name, type, access, persist, min/max/deadband)
 *   - the default-value setter     (only for NVS config points)
 *
 * TO ADD A DATA POINT: add ONE line below. Everything regenerates on rebuild.
 *   - NVS points need a UNIQUE, NEVER-REUSED id (their NVS key is "d<id>");
 *     retired ids go into RETIRED_IDS in tools/lint_datapoints.py. With the
 *     per-key store (v4.26) neither list position nor DP_CFG_VERSION matter
 *     for persistence anymore — stored values SURVIVE schema changes; new
 *     points start at their default, type-size or range mismatches fall
 *     back to it.
 *
 * COLUMN MEANING:
 *   DP( name, type, access, persist, id, default, min, max, deadband )
 *     name     : wire identifier (also the C field name, suffixed _img)
 *     type     : BOOL U8 U16 U32 U64 I8 I16 I32 F32 ENUM STR  (size lives here)
 *     access   : RO | RW | WO
 *     persist  : VOLATILE | NVS | STATIC
 *     id       : stable NVS id (Fon=1xx, Network/Net=2xx, Backup=3xx,
 *                Log=4xx); 0 for VOLATILE/STATIC
 *     default  : initial value for NVS points (ignored for VOLATILE/STATIC)
 *     min,max  : validation bounds for RW writes; NAN = unbounded
 *     deadband : analog on-change threshold (engineering units); 0 = none
 *
 * UI ANNOTATIONS (optional, exported as datapoints_meta.json by the lint
 * script): trailing comment per line, e.g.  |*@ unit=bar dec=2 map=state @*|
 * (with slashes instead of pipes).
 * ========================================================================== */

/*    name                       type acc per        id  default  min     max     deadband */

/* --- Device identity (read-only, fixed at boot) ------------------------------ */
DP(   Device_Serial_Number,      U64, RO, STATIC,     0, 0,       NAN,    NAN,    0     )
DP(   Device_HW_Version,         STR, RO, STATIC,     0, 0,       NAN,    NAN,    0     )
DP(   Device_SW_Version,         STR, RO, STATIC,     0, 0,       NAN,    NAN,    0     )
/* Unix timestamp (ms) of the firmware build — generated by the pre-build script
 * tools/gen_build_info.py and embedded as a constant in the image. */
DP(   Device_Build_Version,      U64, RO, STATIC,     0, 0,       NAN,    NAN,    0     )   /*@ fmt=datetime @*/

/* --- System runtime / health (computed; refreshed via dp_refresh) ------------ */
DP(   System_Temperature,        F32, RO, VOLATILE,   0, 0,       NAN,    NAN,    1.0f  )   /*@ unit=°C dec=1 @*/
DP(   System_Utilization,        U8,  RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=% @*/
DP(   System_Memory_Free,        U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=B @*/
DP(   System_Min_Memory_Free,    U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=B @*/
DP(   System_Largest_Free_Block, U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=B @*/
DP(   System_Flash_Free,         U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=B @*/
DP(   System_RSSI,               I8,  RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=dBm @*/
DP(   System_Uptime,             U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=s @*/
DP(   System_Min_Stack_Free,     U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=B @*/
/* Unexpected WLAN link losses since boot (each schedules a reconnect). */
DP(   System_Reconnect_Count,    U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
/* esp_reset_reason_t: 1=power-on 3=software 4=panic 5/6/7=watchdog 9=brownout.
 * VOLATILE (not STATIC) so it is included in the periodic dp_report. */
DP(   System_Reset_Reason,       ENUM, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ map=reset @*/
/* Power mode (power_mgmt): 0=HIGH (160 MHz, PS off), 1=LOW (DFS 80 MHz,
 * modem sleep, 60 s protocol grid) after 5 min without activity. */
DP(   System_Power_Mode,         U8,  RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ map=power @*/
/* Event-manager queue overflows since boot (should stay 0). */
DP(   System_Event_Drops,        U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )

/* --- Link quality (Link_Robustness_v1): score 0-100 (EMA), state
 * 0=GOOD 1=POOR (hysteresis 40/55); history travels as NET_SAMPLE log
 * records over the log pull. ------------------------------------------- */
DP(   Net_Link_Score,            U8,  RO, VOLATILE,   0, 100,     NAN,    NAN,    0     )
DP(   Net_Link_State,            U8,  RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ map=linkstate @*/
DP(   Net_Session_Drops,         U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   Net_Send_Fail_Count,       U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   Net_Offline_Seconds,       U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=s @*/
DP(   Net_Last_Offline_S,        U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=s @*/

/* --- Ambient climate (AM2302 on GPIO4, read at the climate interval) --------- */
DP(   Ambient_Temperature,       F32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0.2f  )   /*@ unit=°C dec=1 @*/
DP(   Ambient_Humidity,          F32, RO, VOLATILE,   0, 0,       NAN,    NAN,    1.0f  )   /*@ unit=%rH dec=1 @*/

/* --- Fountain measurement & status (written by the pump module) -------------- */
DP(   Fon_Current_Pressure,      F32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0.05f )   /*@ unit=bar dec=2 @*/
/* Raw sensor voltage: < 500 mV (= 0 PSI point) indicates a broken wire/sensor. */
DP(   Fon_Sensor_Voltage_mV,     U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=mV @*/
DP(   Fon_Current_State,         ENUM, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ map=state @*/
DP(   Fon_Relay_Output,          BOOL, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ map=onoff @*/
DP(   Fon_Run_Time,              U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=s @*/
DP(   Fon_Cycles_Total,          U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   Fon_Remaining_Time,        U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=s @*/
/* Pump-manager observation (work package 5). Demand: 0=none 1=unknown
 * 2=hand 3=tank 4=leak-suspect 5=pipe-break 6=sensor. Fault codes:
 * 0=none 1=sensor 2=critical-low 3=max-runtime 4=dry-run 5=starts/hour. */
DP(   Fon_Pressure_Filtered,     F32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0.05f )   /*@ unit=bar dec=2 @*/
DP(   Fon_Pressure_Slope,        F32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0.01f )   /*@ unit=bar/s dec=3 @*/
DP(   Fon_Demand_State,          ENUM, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ map=demand @*/
DP(   Fon_Anomaly_Score,         U16, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   Fon_Event_Duration,        U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /* s */   /*@ unit=s @*/
DP(   Fon_Est_Flow_L_Min,        F32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0.1f  )   /*@ unit=l/min dec=1 @*/
DP(   Fon_Est_Volume_Total,      F32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0.5f  )   /*@ unit=l dec=1 @*/
DP(   Fon_Fault_Code,            U8,  RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ map=fault @*/
DP(   Fon_Starts_Per_Hour,       U8,  RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=/h @*/
/* Cumulative failed pressure readings since boot (I2C glitches etc.; a
 * sensor fault only latches after 3 CONSECUTIVE misses — debounced). */
DP(   Fon_Sensor_Err_Count,      U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
/* Spread (max-min, mV) of the 4-sample ADC burst: sensor/wiring noise. */
DP(   Fon_Sensor_Noise_mV,       U16, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ unit=mV @*/
/* Write 1 = acknowledge a latched pump fault (needs a healthy sensor);
 * polled by the pump task, always reads 0. */
DP(   Fon_Fault_Ack,             U8,  RW, VOLATILE,   0, 0,       0.0f,   1.0f,   0     )
/* Manual classification of the CURRENT/last event (0=unknown 1=none
 * 2=hand 3=tank 4=leak 5=break 6=sensor 7=maintenance); logged on change. */
DP(   Fon_Event_Label,           U8,  RW, VOLATILE,   0, 0,       0.0f,   7.0f,   0     )
/* Pressure simulation override: Fon_Pressure_Manual=1 feeds Fon_Pressure_Value
 * (bar) into the control chain INSTEAD of the sensor — run pressure scenarios
 * without the pump. VOLATILE on purpose: every reboot returns to the hardware
 * sensor, so a stale sim value can never drive a real pump. */
DP(   Fon_Pressure_Manual,       BOOL, RW, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ map=onoff @*/
DP(   Fon_Pressure_Value,        F32, RW, VOLATILE,   0, 0,       0.0f,   100.0f, 0.05f )   /*@ unit=bar dec=2 @*/

/* --- Fountain configuration (RW, NVS). KEEP CONTIGUOUS: one NVS blob region --- */
DP(   Fon_Min_Pressure,          F32, RW, NVS,      101, 2.0f,    0.0f,   10.0f,  0     )   /*@ unit=bar dec=2 @*/
DP(   Fon_Max_Pressure,          F32, RW, NVS,      102, 3.5f,    0.0f,   10.0f,  0     )   /*@ unit=bar dec=2 @*/
DP(   Fon_Alert_High_Pressure,   F32, RW, NVS,      103, 4.5f,    0.0f,   12.0f,  0     )   /*@ unit=bar dec=2 @*/
DP(   Fon_Alert_Low_Pressure,    F32, RW, NVS,      104, 0.3f,    0.0f,   10.0f,  0     )   /*@ unit=bar dec=2 @*/
DP(   Fon_Min_On_Time,           U16, RW, NVS,      105, 30,      0.0f,   3600.0f,0     )   /*@ unit=s @*/
DP(   Fon_Max_On_Time,           U16, RW, NVS,      106, 300,     10.0f,  65535.0f,0    )   /*@ unit=s @*/
DP(   Fon_Dry_Run_Detect_Time,   U16, RW, NVS,      107, 30,      1.0f,   3600.0f,0     )   /*@ unit=s @*/
DP(   Fon_Dry_Run_Min_Rise,      U16, RW, NVS,      108, 100,     0.0f,   10000.0f,0    )
DP(   Fon_Check_Valve_Timeout,   U16, RW, NVS,      109, 10,      1.0f,   3600.0f,0     )   /*@ unit=s @*/
DP(   Fon_Pressure_Drop_Rate,    U16, RW, NVS,      110, 500,     0.0f,   65535.0f,0    )
DP(   Fon_Report_Interval,       U16, RW, NVS,      111, 10,      1.0f,   3600.0f,0     )
DP(   Fon_Sensor_Offset,         I16, RW, NVS,      112, 0,       -5000.0f,5000.0f,0    )
DP(   Fon_Sensor_Scale,          F32, RW, NVS,      113, 1.0f,    NAN,    NAN,    0     )
/* --- Pump manager (work package 5) --------------------------------------
 * Sensor full scale: keeps the original hardware value (0.5-4.5 V ->
 * 0-500 PSI = 34.47 bar) but is runtime-changeable per requirement; the
 * effective curve is bar = (V-0.5)/4.0 * Range * Fon_Sensor_Scale
 * + Fon_Sensor_Offset(mbar). Demand bands/durations classify hand valve
 * vs. tank draw; flow k-factors stay 0 until calibrated (bucket test). */
DP(   Fon_Sensor_Range_Bar,      F32, RW, NVS,      114, 34.47f,  0.1f,   100.0f, 0     )   /*@ unit=bar dec=2 @*/
DP(   Fon_Min_Off_Time,          U16, RW, NVS,      115, 30,      0.0f,   3600.0f,0     )   /*@ unit=s @*/
DP(   Fon_Filter_Alpha,          F32, RW, NVS,      116, 0.1f,    0.01f,  1.0f,   0     )
DP(   Fon_Stable_Slope,          F32, RW, NVS,      117, 0.02f,   0.001f, 1.0f,   0     )
DP(   Fon_Max_Starts_Per_Hour,   U8,  RW, NVS,      118, 10,      1.0f,   16.0f,  0     )
DP(   Fon_Hand_Min_Pressure,     F32, RW, NVS,      119, 1.7f,    0.0f,   100.0f, 0     )   /*@ unit=bar dec=2 @*/
DP(   Fon_Hand_Max_Pressure,     F32, RW, NVS,      120, 2.0f,    0.0f,   100.0f, 0     )   /*@ unit=bar dec=2 @*/
DP(   Fon_Tank_Min_Pressure,     F32, RW, NVS,      121, 1.2f,    0.0f,   100.0f, 0     )   /*@ unit=bar dec=2 @*/
DP(   Fon_Tank_Max_Pressure,     F32, RW, NVS,      122, 1.6f,    0.0f,   100.0f, 0     )   /*@ unit=bar dec=2 @*/
DP(   Fon_Hand_Max_Duration,     U16, RW, NVS,      123, 20,      1.0f,   1440.0f,0     )   /* min */   /*@ unit=min @*/
DP(   Fon_Tank_Max_Duration,     U16, RW, NVS,      124, 12,      1.0f,   1440.0f,0     )   /* min */   /*@ unit=min @*/
DP(   Fon_Unknown_Max_Duration,  U16, RW, NVS,      125, 10,      1.0f,   1440.0f,0     )   /* min */   /*@ unit=min @*/
DP(   Fon_Flow_K_Hand,           F32, RW, NVS,      126, 0,       0.0f,   1000.0f,0     )
DP(   Fon_Flow_K_Tank,           F32, RW, NVS,      127, 0,       0.0f,   1000.0f,0     )

/* --- Network configuration (RW, NVS strings). Must stay within NVS region. ---
 * Defaults come from the embedded network.json (applied on first boot /
 * after an NVS schema change); provision at runtime via dp_write. */
DP(   Network_SSID,              STR, RW, NVS,      201, 0,       NAN,    NAN,    0     )
DP(   Network_Password,          STR, RW, NVS,      202, 0,       NAN,    NAN,    0     )

/* Server endpoint: IP or DNS name (resolved by lwIP at connect time).
 * Empty -> firmware compile-time fallback. */
DP(   Network_Server,            STR, RW, NVS,      203, 0,       NAN,    NAN,    0     )
DP(   Network_Server_Port,       U16, RW, NVS,      204, 8443,    1.0f,   65535.0f,0    )

/* DHCP on (default) or static addressing from the three points below.
 * With DHCP the lease values are mirrored INTO these points after connect
 * (so they always show the effective addressing). Applied on (re)boot. */
DP(   Network_DHCP,              BOOL, RW, NVS,      205, 1,       NAN,    NAN,    0     )   /*@ map=dhcp @*/
DP(   Network_IP_Address,        STR, RW, NVS,      206, 0,       NAN,    NAN,    0     )
DP(   Network_Subnetmask,        STR, RW, NVS,      207, 0,       NAN,    NAN,    0     )
DP(   Network_Gateway,           STR, RW, NVS,      208, 0,       NAN,    NAN,    0     )
/* Modem power-save policy vs. link quality (Link_Robustness_v1 §B3):
 * 0 = auto (LOW mode sleeps, but a POOR link suspends sleeping),
 * 1 = never sleep (max robustness), 2 = always sleep in LOW (max saving). */
DP(   Net_PS_Override,           U8,  RW, NVS,      210, 0,       0.0f,   2.0f,   0     )

/* --- Backup of the network configuration (RO: only the SYSTEM writes these,
 * via network_config_backup() after boot + WLAN + server handshake succeeded;
 * restored into Network_* via Network_Save=3). Part of the NVS region. --- */
DP(   Backup_DHCP,               BOOL, RO, NVS,      301, 1,       NAN,    NAN,    0     )   /*@ map=dhcp @*/
DP(   Backup_IP_Address,         STR, RO, NVS,      302, 0,       NAN,    NAN,    0     )
DP(   Backup_Subnetmask,         STR, RO, NVS,      303, 0,       NAN,    NAN,    0     )
DP(   Backup_Gateway,            STR, RO, NVS,      304, 0,       NAN,    NAN,    0     )
DP(   Backup_Server,             STR, RO, NVS,      305, 0,       NAN,    NAN,    0     )
DP(   Backup_Server_Port,        U16, RO, NVS,      306, 8443,    NAN,    NAN,    0     )
DP(   Backup_SSID,               STR, RO, NVS,      307, 0,       NAN,    NAN,    0     )
DP(   Backup_Password,           STR, RO, NVS,      308, 0,       NAN,    NAN,    0     )

/* --- Logging configuration (Logging_v1.md; persisted, NVS region) ------------
 * Runtime level 0=OFF 1=ERROR 2=WARN 3=INFO 4=DEBUG 5=TRACE. Flash level
 * applies once the logstore partition exists (USB milestone, package 5). */
DP(   Log_Enabled,               BOOL, RW, NVS,      401, 1,       NAN,    NAN,    0     )
DP(   Log_Runtime_Level,         U8,  RW, NVS,      402, 3,       0.0f,   5.0f,   0     )
DP(   Log_Flash_Level,           U8,  RW, NVS,      403, 2,       0.0f,   5.0f,   0     )

/* --- Network_Save command point (VOLATILE, after the NVS region!) -----------
 * Write 1 = persist the Network_* points, 2 = persist + device reboot,
 * 3 = restore the Backup_* points into Network_* (+ persist),
 * 4 = TRIAL reboot: test the new values; kept only if a server session
 *     comes up within 120 s, otherwise automatic rollback to Backup_*.
 * Handled in task_com BEFORE the generic dp_write batch; always reads 0. */
DP(   Network_Save,              U8,  RW, VOLATILE,   0, 0,       0.0f,   4.0f,   0     )
/* Trial result of the WLAN commit/confirm mechanism (Network_Save=4):
 * 0=idle 1=trial window running 2=confirmed (kept) 3=rolled back. */
DP(   Network_Trial_State,       U8,  RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )   /*@ map=trial @*/

/* --- Logging status + command (VOLATILE) --------------------------------- */
DP(   Log_Next_Seq,              U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   Log_Dropped,               U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   Log_Dropped_Flash,         U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   Log_Prev_Boot_Available,   BOOL, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
/* Write 1 = clear runtime ring, 2 = ack previous-boot log, 3 = force flush.
 * Handled in task_com BEFORE the generic dp_write batch; always reads 0. */
DP(   Log_Command,               U8,  RW, VOLATILE,   0, 0,       0.0f,   3.0f,   0     )

/* --- Pressure history (1 Hz ring, drucksensor_datenstruktur.md) ---------- */
DP(   Pressure_Hist_Next_Seq,    U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   Pressure_Hist_Overwritten, U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   Pressure_Hist_Highwater,   U32, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )

/* --- Watchdog boot diagnosis (VOLATILE; RTC-persisted reboot reason) ------
 * Filled after a watchdog-initiated reboot: which channel escalated, its
 * last checkpoint, and the reboot-brake counter (reboots without a session
 * success; at 3 the watchdog stops rebooting until power cycle). */
DP(   System_WD_Last_Channel,    U8,  RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   System_WD_Last_Checkpoint, U16, RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )
DP(   System_WD_Reboot_Count,    U8,  RO, VOLATILE,   0, 0,       NAN,    NAN,    0     )

/* No #include guard on purpose: this file is meant to be included many times. */
